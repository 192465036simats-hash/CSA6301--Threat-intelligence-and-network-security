        "\n",
        "if score <= 5:\n",
        "    level = \"Low\"\n",
        "elif score <= 10:\n",
        "    level = \"Medium\"\n",
        "elif score <= 15:\n",
        "    level = \"High\"\n",
        "else:\n",
        "    level = \"Critical\"\n",
        "\n",
        "print(\"Risk Score:\", score)\n",
        "print(\"Risk Level:\", level)"
