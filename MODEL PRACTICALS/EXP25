        "records = [\n",
        "    (\"2026-01-01\", \"ABC123\"),\n",
        "    (\"2026-01-02\", \"ABC123\"),\n",
        "    (\"2026-01-03\", \"ABC123\")\n",
        "]\n",
        "\n",
        "valid = True\n",
        "\n",
        "for i in range(1, len(records)):\n",
        "    if records[i][1] != records[i-1][1]:\n",
        "        valid = False\n",
        "\n",
        "if valid:\n",
        "    print(\"Chain of Custody Valid\")\n",
        "else:\n",
        "    print(\"Chain Broken\")"
