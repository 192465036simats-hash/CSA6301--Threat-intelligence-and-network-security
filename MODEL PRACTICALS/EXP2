      "source": [
        "import socket\n",
        "\n",
        "host = input(\"Enter Host: \")\n",
        "\n",
        "for port in [21,22,23,80,443]:\n",
        "    s = socket.socket()\n",
        "    s.settimeout(1)\n",
        "\n",
        "    try:\n",
        "        s.connect((host, port))\n",
        "        print(\"Port\", port, \"Open\")\n",
        "    except:\n",
        "        print(\"Port\", port, \"Closed\")\n",
        "\n",
        "    s.close()"
      ]
