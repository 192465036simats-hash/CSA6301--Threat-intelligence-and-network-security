      ],
      "source": [
        "logs = [\n",
        "    \"INFO Login\",\n",
        "    \"ERROR Database\",\n",
        "    \"INFO Login\"\n",
        "]\n",
        "\n",
        "events = []\n",
        "\n",
        "for log in logs:\n",
        "    level, message = log.split()\n",
        "    events.append({\"level\": level, \"message\": message})\n",
        "\n",
        "print(\"Structured Events:\")\n",
        "print(events)\n",
        "\n",
        "count = {}\n",
        "\n",
        "for e in events:\n",
        "    count[e[\"level\"]] = count.get(e[\"level\"], 0) + 1\n",
        "\n",
        "print(\"Aggregation:\")\n",
        "print(count)"
      ]
    }
