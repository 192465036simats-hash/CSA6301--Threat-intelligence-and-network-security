        "message = input(\"Enter Message: \")\n",
        "key = 5\n",
        "\n",
        "encrypted = \"\"\n",
        "\n",
        "for ch in message:\n",
        "    encrypted += chr(ord(ch) ^ key)\n",
        "\n",
        "print(\"Encrypted:\", encrypted)\n",
        "\n",
        "decrypted = \"\"\n",
        "\n",
        "for ch in encrypted:\n",
        "    decrypted += chr(ord(ch) ^ key)\n",
        "\n",
        "print(\"Decrypted:\", decrypted)"
