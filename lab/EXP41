        "def triage_alert(alert_description, rules):\n",
        "    text = alert_description.lower()\n",
        "    for priority, keywords in rules:\n",
        "        for kw in keywords:\n",
        "            if kw in text:\n",
        "                return priority\n",
        "    return \"P4 - Low\"\n",
        "\n",
        "SOC_TRIAGE_RULES = [\n",
        "    (\"P1 - Critical\", [\"ransomware detonation confirmed\", \"domain admin account compromised\", \"active data exfiltration in progress\"]),\n",
        "    (\"P2 - High\", [\"malware detected on endpoint\", \"multiple failed administrator logins\", \"command-and-control beacon detected\"]),\n",
        "    (\"P3 - Medium\", [\"acceptable use policy violation\", \"login from an unusual location\", \"port scan detected against a server\"])\n",
        "]\n",
        "\n",
        "d1 = \"SIEM confirms active data exfiltration in progress from the finance share.\"\n",
        "print(triage_alert(d1, SOC_TRIAGE_RULES))"
      ]
